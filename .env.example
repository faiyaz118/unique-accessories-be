# Local Postgres from `docker compose up -d`, or Supabase's pooled connection string
# for the running API. Use the direct (non-pooled) Supabase URL when running migrations.
DATABASE_URL="postgresql://unique_accessories:12345@localhost:5432/unique_accessories_dev?schema=public"
PORT=4000
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# LOG_LEVEL=debug
# TRUST_PROXY=false

# Required in production (min 32 characters). Development uses a built-in default.
# JWT_SECRET=

# Cloudflare R2 — set all five, or leave them all unset.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=unique-accessories
# R2_PUBLIC_URL=https://media.example.com
